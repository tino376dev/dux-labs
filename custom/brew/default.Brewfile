# Homebrew applications
# All optional Homebrew formulae; install via: ujust install-default-apps

# Cloud and developer services
brew "azure-cli"
brew "databricks"
brew "gh"

# Shells and command-line utilities
brew "bat"
brew "carapace"
brew "dust"
brew "eza"
brew "fd"
brew "fish"
brew "git-delta"
brew "glow"
brew "nushell"
brew "ripgrep"
brew "starship"
brew "vivid"
brew "yazi"
brew "zoxide"

# Editors and language tooling
brew "helix"
brew "markdown-oxide"
brew "marksman"
brew "micro"
brew "tinymist"
brew "typst"
brew "vscode-langservers-extracted"

# Testing, formatting, and linting
brew "bats-core"
brew "dprint"
brew "ruff"
brew "shellcheck"
brew "topiary"

# Mathematics
brew "numbat"
