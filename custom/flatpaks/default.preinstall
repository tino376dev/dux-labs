# Flatpak applications installed on first boot.
#
# Format: an INI file read by `flatpak preinstall`, one section per app:
#
#   [Flatpak Preinstall APP_ID]
#   Branch=stable
#
# Comments must start with '#'; the parser is GKeyFile, so a ';' line is a
# syntax error, and flatpak discards the entire file when one line is malformed.
# See: https://docs.flatpak.org/en/latest/flatpak-command-reference.html#flatpak-preinstall
#
# App IDs are listed at https://flathub.org/ and verified by
# `just validate-flatpaks` before a change can land.

# Local-first, plain-text knowledge base.
[Flatpak Preinstall com.logseq.Logseq]
Branch=stable

# Remote desktop client for RDP, VNC, SSH and other protocols.
[Flatpak Preinstall org.remmina.Remmina]
Branch=stable

# The Flathub package is community-maintained and not endorsed by Signal.
[Flatpak Preinstall org.signal.Signal]
Branch=stable

# Email, calendar and newsgroup client. Fedora ships no mail client by default.
[Flatpak Preinstall org.mozilla.Thunderbird]
Branch=stable

# Audit and restrict the permissions of installed Flatpaks. There is no RPM
# equivalent, so this only makes sense as a Flatpak.
[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable

# Browse and install GNOME Shell extensions. The packaged gnome-extensions-app
# can only configure extensions that are already installed.
[Flatpak Preinstall com.mattjakeman.ExtensionManager]
Branch=stable

# Add another by appending a section, for example:
#
# [Flatpak Preinstall io.github.flattool.Warehouse]
# Branch=stable
